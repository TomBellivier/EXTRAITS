# EXTRAITS, NVIDIA GPU image (CUDA runtime from the official PyTorch image).
#
#   docker build -f docker/Dockerfile.cuda -t extraits:cuda .
#   docker run --rm --gpus all -v "$PWD/workspace:/workspace" --user "$(id -u):$(id -g)" \
#       extraits:cuda process -i /workspace/images -o /workspace/results.csv
#
# Needs the NVIDIA Container Toolkit on the host. Includes the training framework
# (extraits train / finetune). Same layout, licence and behaviour as docker/Dockerfile.

ARG BASE_IMAGE=pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime
FROM ${BASE_IMAGE}

LABEL org.opencontainers.image.title="extraits" \
      org.opencontainers.image.description="EXTRAITS: morphological traits from dorsal images of insects (CUDA)" \
      org.opencontainers.image.licenses="AGPL-3.0-only"

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONUNBUFFERED=1 \
    MPLBACKEND=Agg \
    EXTRAITS_WORKSPACE=/workspace \
    EASYOCR_MODULE_PATH=/opt/easyocr \
    YOLO_CONFIG_DIR=/tmp/Ultralytics \
    HOME=/tmp

# torch and torchvision come with the base image (CUDA build): pip keeps them.
ARG EXTRAS="train"
COPY pyproject.toml README.md /opt/extraits/
COPY src /opt/extraits/src
RUN pip install "/opt/extraits${EXTRAS:+[$EXTRAS]}"

RUN python -c "from extraits.models import prefetch_ocr_weights; prefetch_ocr_weights()" \
    && chmod -R a+rX /opt/easyocr

COPY docker/entrypoint.sh /usr/local/bin/extraits-entrypoint
COPY docker/NOTICE LICENSES/AGPL-3.0.txt /usr/share/doc/extraits/
RUN chmod a+rx /usr/local/bin/extraits-entrypoint

WORKDIR /workspace
VOLUME ["/workspace"]
ENTRYPOINT ["extraits-entrypoint"]
CMD ["--help"]
